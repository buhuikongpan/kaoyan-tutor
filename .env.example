# ===== 考研学习平台 配置 =====

HOST=0.0.0.0
PORT=8000

# ===== 访问令牌（可选，安全增强）=====
# 留空 = 不鉴权（默认，开箱即用）；设置后所有 /api 接口需在页面
# ⚙️设置 中填写此令牌才能访问。局域网内多人使用时强烈建议开启。
PLATFORM_TOKEN=

# ===== DeepSeek（主聊天模型，必填；流式输出）=====
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ===== 智谱 GLM-4V（视觉模型，看图用）=====
# 在 https://open.bigmodel.cn/ 注册获取
ZHIPU_API_KEY=your-zhipu-api-key

# ===== 千问（语音识别 ASR，字幕提取）=====
# 在 https://dashscope.console.aliyun.com/ 获取
QWEN_API_KEY=sk-your-qwen-api-key